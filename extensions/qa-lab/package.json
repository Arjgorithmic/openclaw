{
  "name": "@kibo/qa-lab",
  "version": "2026.4.10",
  "private": true,
  "description": "Kibo QA lab plugin with private debugger UI and scenario runner",
  "type": "module",
  "devDependencies": {
    "@kibo/plugin-sdk": "workspace:*",
    "kibo": "workspace:*"
  },
  "peerDependencies": {
    "kibo": ">=2026.4.10"
  },
  "peerDependenciesMeta": {
    "kibo": {
      "optional": true
    }
  },
  "kibo": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@kibo/qa-lab",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.4.10"
    }
  }
}
