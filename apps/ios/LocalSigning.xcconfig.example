// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

KIBO_CODE_SIGN_STYLE = Automatic
KIBO_DEVELOPMENT_TEAM = YOUR_TEAM_ID

KIBO_APP_BUNDLE_ID = ai.kibo.client
KIBO_SHARE_BUNDLE_ID = ai.kibo.client.share
KIBO_ACTIVITY_WIDGET_BUNDLE_ID = ai.kibo.client.activitywidget
KIBO_WATCH_APP_BUNDLE_ID = ai.kibo.client.watchkitapp
KIBO_WATCH_EXTENSION_BUNDLE_ID = ai.kibo.client.watchkitapp.extension

// Leave empty with automatic signing.
KIBO_APP_PROFILE =
KIBO_SHARE_PROFILE =
KIBO_WATCH_APP_PROFILE =
KIBO_WATCH_EXTENSION_PROFILE =
